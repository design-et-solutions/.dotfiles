[Unit]
Description=Run Parrot Sphinx

[Service]
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=parrot-ue4-landscape-ecosystem -gps-json='{"lat_deg": 48.832698, "lng_deg": 2.289975, "elevation": 2.0}' -config-file=/home/me/sphinx_paths/human_path.yaml l -ams-path=HumanNearDrone,Jasper -light-intensity=2000 -quality=high
Restart=always
RestartSec=5s
User=me

[Install]
WantedBy=multi-user.target
