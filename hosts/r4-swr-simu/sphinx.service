[Unit]
Description=Run Parrot Sphinx
After=ue4.service

[Service]
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=sphinx "/opt/parrot-sphinx/usr/share/sphinx/drones/anafi_ai.drone"::firmware="/home/$USER/Sphinx_test/anafi2-pc-wo-streams.ext2.zip"::remote_ctrl_ip=10.202.0.254::wan_access=1::wifi_iface=""
Restart=always
RestartSec=5s
User=me

[Install]
WantedBy=multi-user.target
